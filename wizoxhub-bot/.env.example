# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Right-click your welcome channel → Copy Channel ID (turn on Developer Mode in Discord settings first)
WELCOME_CHANNEL_ID=

# --- Tickets ---
# Role that can see and answer tickets (right-click the role → Copy Role ID)
SUPPORT_ROLE_ID=

# Optional: category new ticket channels go into (right-click the category → Copy Category ID)
TICKET_CATEGORY_ID=

# Optional: channel where "ticket closed" notes are posted
TICKET_LOG_CHANNEL_ID=
